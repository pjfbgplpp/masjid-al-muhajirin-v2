{
  "entities": {
    "DisplayConfig": {
      "title": "Display Configuration",
      "description": "Configuration schema for a Masjid TV display",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique display identifier" },
        "code": { "type": "string", "description": "Unique display pairing code" },
        "name": { "type": "string", "description": "Display name or location description" },
        "masjidName": { "type": "string", "description": "Name of the Masjid" },
        "address": { "type": "string", "description": "Address of the Masjid" },
        "city": { "type": "string", "description": "City for prayer time calculation" },
        "country": { "type": "string", "description": "Country code or name" },
        "location": { "type": "object", "description": "Geographic coordinates and calculation method" },
        "prayerAdjustments": { "type": "object", "description": "Manual prayer time offsets in minutes" },
        "prayerModeSettings": { "type": "object", "description": "Iqamah countdown and screen blackout settings" },
        "theme": { "type": "object", "description": "Color themes, backgrounds, fonts, and borders" },
        "layout": { "type": "object", "description": "Layout style, font sizing, and widget positions" },
        "slides": { "type": "array", "description": "Carousel slides for posters, kajians, and agendas" },
        "announcements": { "type": "array", "description": "Announcement items" },
        "runningTexts": { "type": "array", "description": "Marquee running ticker texts" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["code", "masjidName"]
    }
  },
  "firestore": {
    "/displays/{displayCode}": {
      "schema": "DisplayConfig",
      "description": "Collection of TV display configurations indexed by display code"
    }
  }
}
