# Gemini API Key for AI Assistant features (server-side only)
GEMINI_API_KEY=

# Supabase Configuration for Cloud Database & Realtime Sync
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: used server-side instead of SUPABASE_ANON_KEY if set (higher privileges)
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: guards the /api/keep-alive Vercel cron endpoint against public calls
CRON_SECRET=
